        {
          "name": "GetAdminPosts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({\r\n    url: pm.environment.get(\"baseUrl\") + \"/api/admin/users/authors\",\r\n    method: 'GET',\r\n    header: {\r\n        'Authorization': 'Bearer ' + pm.environment.get(\"jwtToken\"),\r\n        'Content-Type': 'application/json'\r\n    }\r\n}, function (res) {\r\n    if (res.code === 200) {\r\n        var responseData = res.json();\r\n        var authors = Array.isArray(responseData) ? responseData : (responseData.value || responseData.data || responseData.items);\r\n        \r\n        if (authors && authors.length > 0) {\r\n            var authorId = authors[0].id || authors[0].userId;\r\n            pm.environment.set(\"dynamic_author_id\", authorId);            \r\n        }\r\n    }\r\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
